{
  "name": "painfold",
  "version": "0.2.0",
  "private": true,
  "description": "Find what hurts your customers, without exposing who they are.",
  "license": "MIT",
  "author": "Francis Akoji",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/fetch-model.ts && nuxt dev",
    "generate": "node scripts/fetch-model.ts && nuxt generate && node scripts/remove-spa-fallback.ts && node scripts/apply-csp.ts",
    "serve": "node scripts/serve-static.ts",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "node scripts/eval.ts",
    "bench": "BENCH=1 playwright test performance --reporter=line",
    "postinstall": "nuxt prepare",
    "licenses": "license-checker-rseidelsohn --excludePrivatePackages --excludePackages \"tosource@2.0.0-alpha.3\" --excludePackagesStartingWith \"@img/sharp-libvips-\" --onlyAllow \"MIT;Apache-2.0;ISC;BSD-2-Clause;BSD-3-Clause;0BSD;BlueOak-1.0.0;CC0-1.0;Python-2.0;MPL-2.0;CC-BY-4.0;CC-BY-3.0\" --summary",
    "headers:vercel": "node scripts/write-vercel-config.ts",
    "models": "node scripts/fetch-model.ts",
    "test:model": "vitest run --config vitest.model.config.ts",
    "eval:names": "node scripts/eval-names.ts",
    "verify": "node scripts/verify.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@nuxtjs/i18n": "10.6.0",
    "nuxt": "4.6.4",
    "papaparse": "5.7.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "eslint": "10.14.0",
    "license-checker-rseidelsohn": "5.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "onnxruntime-node": false,
    "sharp": false,
    "protobufjs": false
  }
}
