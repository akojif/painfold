// Cloudflare hosting: the generated site as static files, and a Worker
// (deploy/worker.ts) that serves only the name model, from R2, on the same
// origin. Security headers come from deploy/headers.ts: the _headers file in
// the build for static files, and the Worker for the model.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "painfold",
  "main": "deploy/worker.ts",
  "compatibility_date": "2026-10-23",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": true,
  // The Worker writes no logs, and none are kept.
  "observability": { "enabled": false },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    // Pages live at /accuracy/ (accuracy/index.html); /accuracy redirects there.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get 404.html with a real 404 status.
    "not_found_handling": "404-page",
    "run_worker_first": ["/models/*"]
  },
  "r2_buckets": [{ "binding": "MODELS", "bucket_name": "painfold-models" }]
}
